{
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.2.4"
  },
  "name": "myinventory_frontend",
  "version": "1.0.0",
  "description": "Frontend for myInventory",
  "main": "src/app.js",
  "scripts": {
    "dev": "npm run build && rspack dev",
